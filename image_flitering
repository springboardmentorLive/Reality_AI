from PIL import Image, ImageEnhance
import matplotlib.pyplot as plt
# Open the image
im = Image.open("flower.jpg").convert("RGB")
# Create a solid color image (same size)
blue_tint = Image.new("RGB", im.size, (255, 0, 255))  # Pure blue
# Blend the original with the blue tint
tinted = Image.blend(im, blue_tint, alpha=0.5)  # Adjust alpha for intensity
# Display the result
plt.imshow(tinted)
plt.axis('off')
plt.title("Blue-Tinted Image")
plt.show()
